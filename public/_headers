# Cloudflare Pages response headers
# Vite puts a content hash in every file name under /assets, so these files can be cached for a year.
# Cross-Origin-Resource-Policy stops other websites from embedding (hotlinking) these files.
# Pages adds "Access-Control-Allow-Origin: *" by default, which would let other sites load the files
# with CORS instead, so that header is removed for /assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
  ! Access-Control-Allow-Origin
